# Copie para .env e ajuste. Em desenvolvimento, tudo aqui é opcional.

# URL pública do site (sem barra no final). Usada em links de e-mail, sitemap e Open Graph.
SITE_URL=http://localhost:3000

# Segredo da aplicação (obrigatório em produção, mínimo 32 caracteres): openssl rand -base64 48
APP_SECRET=

# Banco de dados. Padrão: arquivo SQLite local. Para banco remoto (Turso): libsql://... + token.
DATABASE_URL=file:./data/nos.db
DATABASE_AUTH_TOKEN=

# Pasta dos uploads (fotos do site, contratos, comprovantes). Precisa ser persistente em produção.
UPLOAD_DIR=./data/uploads

# Fuso horário do estúdio (agenda, prazos, janela da barra de avisos).
APP_TIMEZONE=America/Sao_Paulo

# E-mail (recuperação de senha e aviso de novo lead). Sem SMTP nada é enviado: em produção o log do servidor recebe
# só uma linha de aviso por e-mail (sem o texto nem o link). Para trocar uma senha sem SMTP: Painel > Configurações >
# Usuários > Nova senha, ou "npm run user:create -- --email ... --reset".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NÓS Studio <contato@seudominio.com.br>"

# Lembretes da agenda: o próprio servidor confere a cada minuto e envia os avisos (no painel e, com SMTP, por
# e-mail). Para desligar esse temporizador e disparar por cron ("npm run reminders" a cada minuto), use "off".
# Rodar os dois ao mesmo tempo é seguro: nenhum lembrete sai duas vezes.
REMINDERS_TIMER=on

# Quantos proxies confiáveis ficam na frente do app (para ler o IP real do visitante no X-Forwarded-For):
# só Nginx, Caddy ou Traefik = 1; Cloudflare + Nginx = 2. O proxy precisa SOBRESCREVER o X-Forwarded-For
# (ver README, "Publicação"). Com o número errado, todos os visitantes dividem o mesmo limite de tentativas.
TRUSTED_PROXIES=1
