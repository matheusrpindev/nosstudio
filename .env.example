# Copie para .env e ajuste. Em desenvolvimento, tudo aqui é opcional.

# URL pública do site (sem barra no final). Usada em links de e-mail, sitemap e Open Graph.
SITE_URL=http://localhost:3000

# Segredo da aplicação (obrigatório em produção, mínimo 32 caracteres): openssl rand -base64 48
APP_SECRET=

# Banco de dados. Padrão: arquivo SQLite local. Para banco remoto (Turso): libsql://... + token.
DATABASE_URL=file:./data/nos.db
DATABASE_AUTH_TOKEN=

# Pasta dos uploads (fotos do site, contratos, comprovantes). Precisa ser persistente em produção.
UPLOAD_DIR=./data/uploads

# Fuso horário do estúdio (agenda, prazos, janela da barra de avisos).
APP_TIMEZONE=America/Sao_Paulo

# E-mail (recuperação de senha e aviso de novo lead). Sem SMTP, os e-mails saem só no log do servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NÓS Studio <contato@seudominio.com.br>"

# Quantos proxies confiáveis ficam na frente do app (Nginx/Cloudflare/Vercel = 1).
TRUSTED_PROXIES=1
